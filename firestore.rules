rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // PERFIS - leitura pública (vitrine e agendar precisam)
    match /perfis/{userId} {
      allow read: if true; // público
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // SERVIÇOS - leitura pública
    match /servicos/{servicoId} {
      allow read: if true; // público
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // AGENDAMENTOS
    match /agendamentos/{agendamentoId} {
      // Dono lê e gerencia
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Qualquer um pode criar (link público de agendamento)
      allow create: if true;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // CLIENTES
    match /clientes/{clienteId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // Qualquer um pode criar (quando agenda pelo link)
      allow create: if true;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}